@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model Product

@{
    Layout = "_Layout";
    ViewData["Title"] = "Details";
}

<table class="table table-primary">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Name</th>
            <th scope="col">Price</th>
            <th scope="col">Description</th>
            <th scope="col">Quantity</th>
            <th scope="col">Tools</th>
            <th scope="col">CategoryName</th>
            <th scope="col">ImagePath</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>@Model.Id</td>
            <td>@Model.Name</td>
            <td>@Model.Price</td>
            <td>@Model.Description</td>
            <td>@Model.Quantity</td>
            <td>
                <a href="@Url.Action("UpdateProduct", new { id = @Model.Id })" class="btn btn-primary">Update</a>
                <a href="@Url.Action("GetDeleteProduct", new { id = @Model.Id })" class="btn btn-danger">Delete</a>
            </td>
            <td>@Model.Category.Name</td>
            <td>
                @foreach (var image in Model.ProductImages)
                {
                    <span>@image.ImageUrl</span>
                
                    <hr />
                }
            </td>
        </tr>
    </tbody>
    </table>